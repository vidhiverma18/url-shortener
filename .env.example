# Copy to .env and edit. Docker Compose reads .env automatically; it is gitignored, so
# nothing you put there can be committed by accident.
#
#   cp .env.example .env
#
# Every value below is optional — the defaults run the full demo locally.

# ── Host ports ───────────────────────────────────────────────────────────────
# Only the host side moves; the containers keep their standard ports. Set these if something
# is already listening — an existing PostgreSQL on 5432 is the usual collision.
# APP_PORT=8080
# POSTGRES_PORT=5432
# REDIS_PORT=6379

# ── Public address ───────────────────────────────────────────────────────────
# What the API puts in the "shortUrl" it returns. It follows APP_PORT on its own, so set this
# only when the service is reachable at some other address — a deployed host, or a tunnel.
# Links built on localhost resolve only on this machine.
# SHORTENER_BASE_URL=https://sho.rt

# ── Secrets ──────────────────────────────────────────────────────────────────
# Keys the short-code permutation and the visitor hash. Change it anywhere real, then leave it
# alone: changing it later changes the codes minted from that point on. Existing links keep
# working, because codes are stored rather than recomputed.
# SHORTENER_CODE_SECRET=$(openssl rand -base64 48)

# Token signing key, minimum 32 bytes. With neither set, the application generates a random
# key per process and warns — tokens then stop working across a restart, which is visible
# rather than silent. Prefer the file over the variable: environment variables are readable
# through /proc, crash dumps and container inspection APIs.
# SHORTENER_JWT_SECRET=
# SHORTENER_JWT_SECRET_FILE=/run/secrets/jwt-signing-key

# POSTGRES_PASSWORD=shortener_local_dev

# ── Behaviour ────────────────────────────────────────────────────────────────
# Demo accounts (alice, bob, admin). Turn this off anywhere that is not a local demo.
# SHORTENER_SEED_DEMO_USERS=true

# Destination reputation checking, at creation and on the rescan sweep.
# SHORTENER_SCREENING_ENABLED=true

# Enables Google Safe Browsing. Without a key only the local blocklist runs, so the service
# has no third-party dependency out of the box.
# SHORTENER_SAFE_BROWSING_KEY=

# Whether an unreachable revocation store rejects tokens instead of accepting them. Failing
# closed turns a Redis outage into a total authentication outage; that is the right trade only
# where a revoked token being honoured briefly is the more expensive failure.
# SHORTENER_REVOCATION_FAIL_CLOSED=false
